# Copy to .env and fill in. The .env file is gitignored.
#
# On Vercel these go in Project Settings -> Environment Variables,
# NOT in a committed file.

# https://api.imgbb.com/ -> "Get API key". Used by the Image content type.
# NOTE: this key is embedded into the page at build time and is therefore
# readable by anyone who views source. Use a key created solely for this
# site, and expect to rotate it. See README for why.
IMGBB_KEY=

# Optional. Seconds until ImgBB auto-deletes an upload (60-15552000).
# Blank = uploads are kept permanently.
IMGBB_EXPIRY_SECONDS=

# Optional. Canonical site URL, e.g. https://getqode.vercel.app
# Leave blank on Vercel: the build derives it from VERCEL_PROJECT_PRODUCTION_URL.
SITE_URL=

# ---- Switchable links -------------------------------------------------------
# The database behind /switch and /go/<key>. Server-side only: these are read
# by the serverless functions in api/ and are never embedded into the page.
# Create a database at https://turso.tech, then `turso db show --url <name>`
# and `turso db tokens create <name>`.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# The password for /switch. Without it, saving is disabled entirely; with a
# weak one, anyone can repoint every code you have ever printed. Generate one
# with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
QODE_ADMIN_TOKEN=

# Optional. Google Safe Browsing lookup key, checked against every destination
# before it is saved. Free: https://developers.google.com/safe-browsing/v4
# Without it the static checks (other shorteners, punycode lookalikes, private
# addresses) still apply; with it, known malware and phishing URLs are refused
# outright. Strongly recommended once /switch sees real traffic.
SAFE_BROWSING_KEY=
